{
  "name": "ai-tamagotchi",
  "version": "0.4.0",
  "private": true,
  "description": "AI Tamagotchi desktop flutuante e acoplavel ao Windows Terminal",
  "author": "AI Tamagotchi contributors",
  "license": "MIT",
  "homepage": "https://github.com/GabrielMouraKT/ai-tamagotchi#readme",
  "repository": { "type": "git", "url": "git+https://github.com/GabrielMouraKT/ai-tamagotchi.git" },
  "bugs": { "url": "https://github.com/GabrielMouraKT/ai-tamagotchi/issues" },
  "keywords": ["claude-code", "statusline", "mascot", "tamagotchi", "electron", "windows", "desktop-pet"],
  "type": "commonjs",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node server.js",
    "desktop": "electron electron/main.cjs",
    "test": "node --test \"test/*.test.js\"",
    "install-statusline": "node install-statusline.js",
    "dist": "electron-builder --win nsis --x64",
    "pack": "electron-builder --win dir --x64"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.18.0"
  },
  "engines": {
    "node": ">=20"
  },
  "build": {
    "appId": "com.aitamagotchi.desktop",
    "productName": "AI Tamagotchi",
    "copyright": "AI Tamagotchi",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": [
      "electron/**",
      "lib/**",
      "assets/**",
      "mascotes/**",
      "!mascotes/**/*.gif",
      "index.html",
      "style.css",
      "app.js",
      "desktop-ui.js",
      "mascots.json",
      "server.js",
      "statusline.js",
      "install-statusline.js",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "electron/follow-terminal.ps1",
      "statusline.js",
      "lib/**",
      "package.json"
    ],
    "extraResources": [
      { "from": "build/statusline.cmd", "to": "statusline.cmd" }
    ],
    "win": {
      "target": [ { "target": "nsis", "arch": [ "x64" ] } ],
      "icon": "build/icon.ico",
      "artifactName": "AI-Tamagotchi-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AI Tamagotchi",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
